# .env.example — autogenerated by `make env-example`. Do not edit by hand.
# Copy to .env and fill in values for required entries.

# OpenRouter API key (sk-or-...)
# (required)
OPENROUTER_API_KEY=

# (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# (default: anthropic/claude-haiku-4.5)
OPENROUTER_ATOMIZE_MODEL=anthropic/claude-haiku-4.5

# (default: openai/whisper-1)
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-1

# (default: https://github.com/aleksejmetlusko/second-brain)
OPENROUTER_HTTP_REFERER=https://github.com/aleksejmetlusko/second-brain

# (default: Second Brain)
OPENROUTER_X_TITLE="Second Brain"

# (required)
TELEGRAM_BOT_TOKEN=

# CSV of allowlisted Telegram user IDs
# (required)
ALLOWED_USER_IDS=

# (default: /data/notes)
NOTES_DIR=/data/notes

# (default: /etc/second-brain)
CONFIG_DIR=/etc/second-brain

# (default: 120s)
HTTP_TIMEOUT=120s

# (default: 180s)
TRANSCRIBE_TIMEOUT=180s

# (default: 60s)
ATOMIZE_TIMEOUT=60s

# (default: 5s)
FS_WRITE_TIMEOUT=5s

# (default: Europe/Moscow)
TZ=Europe/Moscow

# debug | info | warn | error
# (default: info)
LOG_LEVEL=info

# Voyage AI API key for embeddings
# (required)
VOYAGE_API_KEY=

# (default: voyage-4-large)
EMBEDDING_MODEL=voyage-4-large

# (default: 1024)
EMBEDDING_DIM=1024

# (default: https://api.voyageai.com/v1)
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# (default: /data/index/index.db)
INDEX_DB_PATH=/data/index/index.db

# (default: 5m)
RAG_SCAN_INTERVAL=5m

# (default: 1000)
INDEXER_BATCH_SIZE=1000

# (default: 5)
LINK_TOP_K=5

# (default: 0.70)
LINK_MIN_SIMILARITY=0.70

# (default: 5)
FIND_TOP_K=5

