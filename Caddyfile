# Caddyfile — serves the Quartz-built static site behind basic auth.
# Self-signed TLS via Caddy's local CA (no domain → no Let's Encrypt).
# Browsers will warn about the cert the first time; accept once per device.
#
# Basic-auth user "admin" with bcrypt hash from QUARTZ_BASIC_AUTH_HASH env.
# Generate the hash via:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASS'

{
	auto_https disable_redirects
	admin off
	# TLS clients connecting to a bare IP do NOT send SNI (RFC 6066
	# forbids it). Without a default, Caddy can't pick a site to terminate
	# the handshake → tls alert internal_error. Pin the IP as the default.
	default_sni 89.169.184.228
}

# Bare IP, no DNS — Caddy mints a self-signed cert via its local CA.
# The IP is listed explicitly so it ends up in the cert's SAN.
89.169.184.228:443 {
	tls internal
	basic_auth * {
		admin {env.QUARTZ_BASIC_AUTH_HASH}
	}

	# Quartz writes to /srv/site (subdir of the shared volume so it can
	# safely rmdir its own working area).
	root * /srv/site
	encode gzip zstd
	# Quartz emits "pretty URLs" — /personal/foo links to a file at
	# /personal/foo.html. Try the extension before giving up.
	try_files {path} {path}.html {path}/index.html
	file_server {
		index index.html
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
